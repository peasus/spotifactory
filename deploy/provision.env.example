# Your values for every box you set up. Copy to deploy/provision.env (it's
# git-ignored) and fill in once; setup.sh merges these into each box's .env.
# On a fresh Pi, either put it in the cloned repo at deploy/provision.env or
# copy it to the Pi user's home folder first:
#   scp deploy/provision.env spotifactory@spotifactory.local:~/spotifactory-provision.env
# Any key from deploy/env.example can go here.

# Spotify Developer App client ID. Leave blank to use the project's app (the
# default in env.example); set it to put a batch of boxes on another app, since
# Spotify allows only 5 users per app in development mode.
SPOTIPY_CLIENT_ID=

# Your Cloudflare Worker relay (deploy/relay/), no trailing slash
RELAY_URL=https://auth.spotifactory.workers.dev
