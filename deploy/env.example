# Spotify Developer App (PKCE: the client ID is public, not a secret). This is
# the project's own app; to use your own, register one at
# https://developer.spotify.com/dashboard and set its ID here or in provision.env.
# Every user must be on the app's allowlist (User Management, max 5 per app).
# Add https://YOUR-WORKER.workers.dev/callback as the Redirect URI.
SPOTIPY_CLIENT_ID=d9b1315d7f14456880914de20085164f

# Cloudflare Worker relay URL (no trailing slash).
# Deploy deploy/relay/ first, then paste the worker URL here.
RELAY_URL=https://auth.spotifactory.workers.dev

# Mac development only — not needed on Pi (PKCE is used instead).
# SPOTIPY_CLIENT_SECRET=your_client_secret_here
# SPOTIPY_REDIRECT_URI=http://127.0.0.1:8080/callback

# Hardware platform: "seengreat" (1.3" SH1106 OLED HAT) or "pi" (Adafruit I2C OLED).
SPOTIFACTORY_PLATFORM=seengreat

# Which 1.3" OLED HAT: "seengreat" (default) or "waveshare" (its joystick is
# wired differently, and it can stay in SPI mode).
# SPOTIFACTORY_HAT=waveshare

# NFC reader port — auto-detected on Pi (USB serial adapter).
# Uncomment and set if auto-detection picks the wrong device.
# NFC_PORT=tty:USB0

# Sonos speakers — no configuration needed here. The app detects the active
# Sonos speaker automatically via Spotify's is_restricted flag and uses SoCo
# to control it. One-time setup required on the Sonos system:
#   1. Open the Sonos app → Browse → Add Music Services → Spotify
#   2. Sign in with a Spotify PREMIUM account
#   3. Without Premium, playback will fail with a message on the display.

# Instax printer Classic BT address (optional).
# The app derives this automatically from the BLE scan (FA:AB:BC:xx:xx:xx → 88:B4:36:xx:xx:xx).
# Set manually if auto-derivation doesn't work for your printer:
#   1. Power on the printer
#   2. Run: bluetoothctl scan on   (look for INSTAX-xxxxxxxx (ANDROID) address)
#   3. Paste the ANDROID address here.
# INSTAX_BT_ADDRESS=88:B4:36:xx:xx:xx

# Bluetooth speaker MAC address — set automatically by "Pair Speaker" from the main menu.
# Fill in manually if you want to skip the pairing flow on a device you already trust.
# SPOTIFACTORY_SPEAKER_MAC=AA:BB:CC:DD:EE:FF

# Auto-update: each night the box installs the latest `stable` branch (and the
# menu has Check for Updates). Point your own development box at main, or turn
# the nightly run off:
# SPOTIFACTORY_UPDATE_BRANCH=main
# SPOTIFACTORY_AUTO_UPDATE=0
